# /etc/systemd/system/fleetd-ipintel-fetch.service — 下载 / 更新 IP 情报离线库（由 .timer 每月触发）
[Unit]
Description=fleetd ipintel: refresh offline IP databases (ip2region, DB-IP lite, iptoasn)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=fleetd
Group=fleetd
# /var/lib/fleetd 是 fleetd 的 StateDirectory（0700，属主 fleetd）；库放在它的 ipintel/ 子目录
ExecStart=/bin/sh /opt/fleetd/current/ipintel/fetch-dbs.sh /var/lib/fleetd/ipintel
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=192M
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fleetd
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
