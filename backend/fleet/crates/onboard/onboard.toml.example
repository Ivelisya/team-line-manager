# fleetctl onboard / fleetd 上架流水线配置（中控 38.58.57.22 上：/etc/fleet/onboard.toml，0600 root）
db = "/var/lib/fleet/onboard.db"
catalog = "/etc/fleet/catalog.json"                 # architecture/plan-catalog/catalog.json
work_dir = "/var/lib/fleet/onboard"                 # known_hosts（每台一个）、askpass、ssserver 解包、上传的密码文件
ssh_key = "/etc/fleet/onboard/id_ed25519"           # 上架专用密钥（不要复用旧 provision.key）
ssh_pubkey = "/etc/fleet/onboard/id_ed25519.pub"
client_xray = "/opt/fleet/xray/<sha16>/xray"         # P15 在中控本机起 VLESS REALITY 客户端（中控=线路机2，用 fleet-cutover 装的那份）
concurrency = 5
canary = true
canary_gate = "P16"                                 # 金丝雀要走完全链路才放行其余行
relay_window_s = 30
relay_batch_max = 20
retry_max = 3
retry_base_ms = 5000
keyscan_samples = 5
keyscan_interval_ms = 3000
lease_ttl_s = 20
egress_check_url = "https://www.cloudflare.com/cdn-cgi/trace"
require_bbr = true
dd_wait_timeout_s = 1800

[ss]
tarball = "/var/lib/fleet/dist/shadowsocks-v1.25.0.x86_64-unknown-linux-musl.tar.xz"   # 旁边要有 .sha256
method = "aes-256-gcm"
port = 8388
relay_port_lo = 20001
relay_port_hi = 20999

# P11 装 nodeagent（fleet-edge；与 fleet-edge/deploy/rollout.sh 的节点安装逐项一致）。没有这一节 = P11 跳过。
[agent]
dist = "/var/lib/fleet/dist/fleet-edge"               # fleet-edge/dist/<版本>/ 的拷贝：nodeagent（0755）+ VERSION + SHA256SUMS；fleetd 用户要能读
endpoint = "https://38.58.57.22"                      # nodeagent 上报 {endpoint}/v2/ingest/node（与 rollout.sh 缺省相同）
sample_interval_s = 5
batch_samples = 2
first_batch_timeout_s = 90                            # 等第一批被中控接收的上限
# unit_file = "/path/fleet-nodeagent.service"         # 缺省用内置的一份（= fleet-edge/deploy/fleet-nodeagent.service）
# 只给 fleetctl 独立运行用（fleetd 里忽略：令牌由进程内的 fleetd-ingest 签发）。以 fleetd 用户执行 fleetctl 时：
# token_cmd = "/opt/fleetd/current/fleetd agent-token issue {host_id} --name onboard"
# revoke_cmd = "/opt/fleetd/current/fleetd agent-token revoke {host_id}"

[[providers]]
name = "ATTVPS"
code = "ATT"
[[providers]]
name = "OhnoICU"
code = "MX"
[[providers]]
name = "NodeMach"
code = "NM"

# 至少配两台线路机：P8 反测要用「不在白名单里的另一台线路机」当视角；只配一台且它就是中控时，反测会失败（中控本身在白名单里）。
[[relays]]
name = "线路机3"
host = "38.58.57.69"
ssh_port = 22
ssh_user = "root"
ssh_key = "/etc/fleet/onboard/relay_ed25519"
known_hosts = "/etc/fleet/onboard/relays.known_hosts"
public_host = "38.58.57.69"
allow_ips = ["38.58.57.69"]                          # 节点 8388 只放行这些来源（所属 + 备用线路机）
# xray_bin / asset_dir 默认 "auto"：取正在运行的 fleet-xray 进程的可执行文件（/opt/fleet/xray/<sha16>/xray）及其目录
config = "/etc/fleet/xray/config.json"
api = "127.0.0.1:62789"
sni = "www.cloudflare.com"
max_nodes = 25
