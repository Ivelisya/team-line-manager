  "example": "curl -H \"X-Api-Key: tlm_...\" https://38.58.57.22/ops/api/overview"
 },
 "endpoints": [
  {
   "method": "GET",
   "path": "/provision/defaults",
   "scope": "read",
   "params": "",
   "description": "查询接入线路、端口、团队和软件包信息。"
  },
  {
   "method": "GET",
   "path": "/jobs",
   "scope": "read",
   "params": "limit",
   "description": "查询接入任务列表。"
  },
  {
   "method": "GET",
   "path": "/jobs/<id>",
   "scope": "read",
   "params": "",
   "description": "查询接入任务步骤和结果。"
  },
  {
   "method": "POST",
   "path": "/provision/relay",
   "scope": "write",
   "params": "name,ip,ssh_port,auth,provider,plan,price,currency,billing_cycle,due_date,traffic_reset_day,timezone,note",
   "description": "启动一键接入线路机任务。任务 result 含 pending_ui_actions（前端用管理员会话执行的 Komari REST 调用）"
  },
  {
   "method": "POST",
   "path": "/provision/node",
   "scope": "write",
   "params": "relay,team,provider,service_id,name_number,egress_ip,outbound,plan,bandwidth,price,currency,billing_cycle,due_date,supplier_timezone,note",
   "description": "启动一键接入家宽节点任务。任务 result 含 pending_ui_actions（前端用管理员会话执行的 Komari REST 调用）"
  },
  {
   "method": "GET",
   "path": "/overview",
   "scope": "read",
   "params": "",
   "description": "查询资产、线路快照、流量汇总和健康摘要（assets[].health 只含 status/reason/since/summary_counts，检查明细见 /node）。"
  },
  {
   "method": "GET",
   "path": "/activity",
   "scope": "read",
   "params": "asset,team,action,source_ip,host,kind,protocol,search,seconds,limit,before,cursor",
   "description": "筛选并分页查询访问记录及目标和来源统计。"
  },
  {
   "method": "GET",
   "path": "/history",
   "scope": "read",
   "params": "asset,hours",
   "description": "查询指定资产的历史流量。"
  },
  {
   "method": "GET",
   "path": "/policies",
   "scope": "read",
   "params": "",
   "description": "查询当前策略、草稿及发布版本。"
  },
  {
   "method": "GET",
   "path": "/policies/preview",
   "scope": "read",
   "params": "",
   "description": "根据最近访问记录预览策略草稿的影响。"
  },
  {
   "method": "GET",
   "path": "/audit",
   "scope": "read",
   "params": "",
   "description": "查询最近一百五十条审计记录。"
  },
  {
   "method": "GET",
   "path": "/renewals",
   "scope": "read",
   "params": "",
   "description": "查询最近两百条续费记录。"
  },
  {
   "method": "GET",
   "path": "/export",
   "scope": "read",
   "params": "",
   "description": "导出资产清单和团队汇总。"
  },
  {
   "method": "GET",
   "path": "/health",
   "scope": "read",
   "params": "",
   "description": "查询采集器和监控服务的健康状态；含完整 monitor 汇总（原 /overview.monitor）。"
  },
  {
   "method": "GET",
   "path": "/fleet",
   "scope": "read",
   "params": "",
   "description": "查询线路机和入口的接入及归属状态。"
  },
  {
   "method": "GET",
   "path": "/node",
   "scope": "read",
   "params": "asset",
   "description": "查询节点健康（status/reason/since/checks 四态判定）、可用率、流量和审计详情。"
  },
  {
   "method": "GET",
   "path": "/incidents",
   "scope": "read",
   "params": "asset,status",
   "description": "查询节点故障事件；evidence 含 check、reason 与探针原始证据（rc/phase/ms/measured_at）。"
  },
  {
   "method": "GET",
   "path": "/behavior",
   "scope": "read",
   "params": "asset,team,source_ip,host,action,kind,protocol,search,seconds,limit,offset",
   "description": "查询访问目标统计和行为异常事件。"
  },
  {
   "method": "GET",
   "path": "/public-status",
   "scope": "read",
   "params": "",
   "description": "查询主机在线状态和代理链路健康摘要（link_status/reason 为四态口径）。"
  },
  {
   "method": "GET",
   "path": "/panel/overview",
   "scope": "read",
   "params": "relay",
   "description": "查询面板状态及关联资产的入口流量和出口检查结果；online 表示活跃=最近约 10 秒有流量经过。"
  },
  {
   "method": "GET",
   "path": "/schema",
   "scope": "read",
   "params": "",
   "description": "查询接口认证方式、参数和权限说明。"
  },
  {
   "method": "GET",
   "path": "/api-keys",
   "scope": "full",
   "params": "",
   "description": "列出 API key 的元数据和使用计数。"
  },
  {
   "method": "GET",
   "path": "/api-keys/usage",
   "scope": "full",
   "params": "",
   "description": "查询最近一百条 API key 调用记录。"
  },
  {
   "method": "POST",
   "path": "/assets/edit",
   "scope": "write",
   "params": "uuid,expected_revision,name,note,price,due_date,renewal,renewal_note,capacity_bps",
   "description": "修改资产资料并按需登记续费；capacity_bps 为可选带宽 bit/s，null 清除显式配置，线路机默认 1 Gbps。"
  },
  {
   "method": "POST",
   "path": "/policies/draft",
   "scope": "write",
   "params": "scope,expected_revision,policy",
   "description": "保存指定团队或节点的策略草稿。"
  },
  {
   "method": "POST",
   "path": "/policies/apply",
   "scope": "write",
   "params": "draft_hash,routing_hashes",
   "description": "校验草稿和线路版本后提交策略发布。"
  },
  {
   "method": "POST",
   "path": "/policies/discard",
   "scope": "write",
   "params": "draft_hash",
   "description": "校验草稿版本后丢弃全部策略草稿。"
  },
  {
   "method": "POST",
   "path": "/fleet/add",
   "scope": "write",
   "params": "kind,name,team,ip,price,due_date,billing_timezone,provider,plan,note,relay,relay_port,host_key,ssh_port,request_id",
   "description": "登记资产接入资料并准备接入凭据。"
  },
  {
   "method": "POST",
   "path": "/fleet/activate",
   "scope": "write",
   "params": "relay",
   "description": "验证线路机身份和采集通道后启用线路机。"
  },
  {
   "method": "POST",
   "path": "/fleet/installer",
   "scope": "write",
   "params": "relay",
   "description": "生成指定线路机的安装脚本。"
  },
  {
   "method": "POST",
   "path": "/node/profile",
   "scope": "write",
   "params": "uuid,expected_revision,profile",
   "description": "更新节点维护窗口和监控阈值。"
  },
  {
   "method": "POST",
   "path": "/incidents/ack",
   "scope": "write",
   "params": "id,note",
   "description": "确认故障事件并记录处理备注。"
  },
  {
   "method": "POST",
   "path": "/behavior/ack",
   "scope": "write",
   "params": "id",
   "description": "确认行为异常事件并记录审计。"
  },
  {
   "method": "POST",
   "path": "/panel/action",
   "scope": "write",
   "params": "relay,action,args；inbound_enable{id,enable,confirm:true},inbound_reset{id,confirm:true},client_reset{id,email,confirm:true},xray_restart{confirm:true},inbound_remark{id,remark},client_rotate{id,confirm:true},xray_logs{count},probe_now{port?}",
   "description": "入口启停、重置流量、重启 Xray、改备注、更换首个客户端 UUID、查询日志、立即验证链路。probe_now 可指定入口，省略时验证整条线路；已有验证时返回 ok=false，不重复排队。client_rotate 返回 uuid；xray_logs/probe_now 返回 obj。"
  },
  {
   "method": "POST",
   "path": "/api-keys/create",
   "scope": "full",
   "params": "name,scope（read/write/full）,expires_days（0 为永不过期）",
   "description": "创建 API key 并仅在本次响应返回明文。"
  },
  {
   "method": "POST",
   "path": "/api-keys/revoke",
   "scope": "full",
   "params": "id",
   "description": "吊销指定 API key。"
  },
  {
   "method": "GET",
   "path": "/schema.md",
   "scope": "read",
   "params": "",
   "description": "查询 Markdown 格式的完整接口与 UI 动作说明。"
  },
  {
   "method": "GET",
   "path": "/komari/hosts",
   "scope": "read",
   "params": "",
   "description": "查询每 5 秒同步的 Komari 主机最新状态。"
  },
  {
   "method": "GET",
   "path": "/komari/hosts/<uuid>/metrics",
   "scope": "read",
   "params": "range=1h/4h/1d",
   "description": "查询全部负载指标；Komari RPC 的 hours 为字符串 1/4/24。"
  },
  {
   "method": "GET",
   "path": "/komari/pings",
   "scope": "read",
   "params": "",
   "description": "查询全部 Komari Ping 任务。"
  },
  {
   "method": "GET",
   "path": "/komari/pings/<task_id>/results",
   "scope": "read",
   "params": "hours,uuid（可选）",
   "description": "查询 Ping 历史；task_id 为整数，RPC 按字符串传递，hours 同样为字符串；不传 hours 使用 Komari 的 4 小时范围。"
  },
  {
   "method": "GET",
   "path": "/komari/clients",
   "scope": "read",
   "params": "",
   "description": "查询 Komari 客户端信息，移除每个元素的 token 字段。"
  },
  {
   "method": "POST",
   "path": "/fleet/prepare",
   "scope": "write",
   "params": "同 /fleet/add",
   "description": "准备接入票据；通常直接调用 /fleet/add 完成全部编排。"
  },
  {
   "method": "POST",
   "path": "/fleet/bind",
   "scope": "write",
   "params": "uuid,ticket",
   "description": "绑定 Komari 资产到接入票据。"
  },
  {
   "method": "POST",
   "path": "/fleet/commit",
   "scope": "write",
   "params": "uuid,ticket",
   "description": "提交已绑定的接入资料。"
  }
 ],
