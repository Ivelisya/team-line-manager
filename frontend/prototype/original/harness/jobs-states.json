      "hoverJs": "(()=>{const e=document.getElementById('f').contentDocument.querySelectorAll(\".node-card-grid > div\")[1];if(!e)return null;const r=e.getBoundingClientRect();return {x:r.x+r.width*0.5,y:r.y+r.height*0.35};})()",
      "wait": 500
     }
    ],
    "clipJs": "(()=>{const e=document.getElementById('f').contentDocument.querySelectorAll(\".node-card-grid > div\")[1];if(!e)return null;const r=e.getBoundingClientRect();return {x:Math.max(0,r.x-10),y:Math.max(0,r.y-10),width:r.width+20,height:r.height+20};})()"
   },
