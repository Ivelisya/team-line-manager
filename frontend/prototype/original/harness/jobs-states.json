     }
    ],
    "clipJs": "(()=>{const d=document.getElementById('f').contentDocument;const a=d.querySelector(\".home-group-tabs\"),b=d.querySelector(\".home-sort-trigger\");if(!a||!b)return null;const r1=a.getBoundingClientRect(),r2=b.getBoundingClientRect();const x=Math.min(r1.x,r2.x)-12,y=Math.min(r1.y,r2.y)-12;return {x:Math.max(0,x),y:Math.max(0,y),width:Math.max(r1.right,r2.right)-x+12,height:Math.max(r1.bottom,r2.bottom)-y+12};})()"
