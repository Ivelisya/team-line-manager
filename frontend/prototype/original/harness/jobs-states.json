     {
      "hoverJs": "(()=>{const e=document.getElementById('f').contentDocument.querySelectorAll(\".latency-strip-cell\")[12];if(!e)return null;const r=e.getBoundingClientRect();return {x:r.x+r.width*0.5,y:r.y+r.height*0.5};})()",
