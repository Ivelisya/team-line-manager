#!/bin/sh
# fleet：中控 sshd 给软路由隧道账号 fleet-tunnel 列出允许的公钥。是 /etc/ssh/sshd_config.d/fleet-tunnel.conf 的
# AuthorizedKeysCommand（以 fleet 用户运行，参数是登录的用户名 %u）。由 deploy/central/tunnel-setup.sh 装到
# /usr/local/lib/fleet/tunnel-keys（root 所有、0755，路径上每一级目录 root 所有、别人不可写）。
#
# 清单是 fleet-server 写的 /var/lib/fleet/tunnel-keys（路由增删、重新接入时原子重写），每行「端口 ssh-ed25519 <base64>」。
# 逐行严格校验（端口 23000–23999、类型只收 ssh-ed25519、base64 只许它的字符集与 ed25519 公钥的长度），不合格的行丢掉；
# 每把公钥只许在 127.0.0.1:<自己的端口> 上做反向转发，不能开会话（restrict + command="/bin/false"）。
# 参数不是 fleet-tunnel 时什么都不输出。
set -u
[ "${1:-}" = fleet-tunnel ] || exit 0
F=/var/lib/fleet/tunnel-keys
[ -r "$F" ] || exit 0
while IFS= read -r line || [ -n "$line" ]; do
  set -f
  # shellcheck disable=SC2086
  set -- $line
  set +f
  [ $# -eq 3 ] || continue
  case $1 in 23[0-9][0-9][0-9]) ;; *) continue ;; esac
  [ "$2" = ssh-ed25519 ] || continue
  case $3 in AAAAC3NzaC1lZDI1NTE5AAAAI*) ;; *) continue ;; esac
  case $3 in *[!A-Za-z0-9+/=]*) continue ;; esac
  [ ${#3} -eq 68 ] || continue
  printf 'restrict,port-forwarding,permitlisten="127.0.0.1:%s",command="/bin/false" ssh-ed25519 %s\n' "$1" "$3"
done < "$F"
