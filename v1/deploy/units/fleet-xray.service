[Unit]
Description=Xray (由 fleet-agent 全权管理配置)
After=network-online.target
Wants=network-online.target
# 配置文件由 fleet-agent 生成；首次启动时 agent 会先写入空骨架再拉起本单元
ConditionPathExists=/etc/fleet-agent/xray.json

[Service]
Type=simple
Environment=XRAY_LOCATION_ASSET=/usr/local/share/xray
ExecStart=/usr/local/bin/xray run -c /etc/fleet-agent/xray.json
Restart=always
RestartSec=2
LimitNOFILE=65536
# 访问日志目录 /var/log/fleet-xray（agent 只读）
LogsDirectory=fleet-xray
LogsDirectoryMode=0755
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# 仍以 uid 0 运行：属主是 root 的文件照样读得到。把用不着的敏感路径藏起来——SSH 主机私钥、agent 的令牌与数据目录、
# 密码散列。Xray 只读写配置 /etc/fleet-agent/xray.json、资源 /usr/local/share/xray、访问日志 /var/log/fleet-xray
# （xray api / run -test 是 agent 自己起的子进程，不在本单元里）；不存在的路径由「-」跳过。改了要等 Xray 下次重启才生效。
# /etc/fleet-agent 整个换成空的只读 tmpfs、只把 xray.json 挂回来：令牌要按目录藏——遮单个文件是一次挂载，装 agent 时
# rename 换令牌，内核就把这个挂载摘掉，运行中的 Xray 便读得到新令牌。挂回来的 xray.json 是启动时那一份
# （之后改配置走 API 热更新，要重启时重新挂）。密码散列只能按文件藏，改密码（rename）后到 Xray 下次重启前看得见
TemporaryFileSystem=/etc/fleet-agent:ro
BindReadOnlyPaths=/etc/fleet-agent/xray.json
InaccessiblePaths=-/etc/ssh -/var/lib/fleet-agent -/etc/shadow -/etc/shadow- -/etc/gshadow -/etc/gshadow-
# 不加 SystemCallFilter / MemoryDenyWriteExecute：Xray 是 Go 程序，升级 Xray 时运行时用到的系统调用会变，兼容风险大于收益。
# 不加 ProcSubset=pid：它藏掉 /proc/sys，Go 读不到 somaxconn，入口的监听队列从 4096 掉到 128（安全评分不变）

[Install]
WantedBy=multi-user.target
