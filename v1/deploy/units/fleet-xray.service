[Unit]
Description=Xray (由 fleet-agent 全权管理配置)
After=network-online.target
Wants=network-online.target
# 配置文件由 fleet-agent 生成；首次启动时 agent 会先写入空骨架再拉起本单元
ConditionPathExists=/etc/fleet-agent/xray.json

[Service]
Type=simple
Environment=XRAY_LOCATION_ASSET=/usr/local/share/xray
# 不以 root 运行：动态用户（每次启动由 systemd 分配，不用事先建用户，不会因为缺用户起不来）。
# 配置由 systemd 以 root 打开、作为标准输入交给 Xray（-c stdin:），Xray 自己读不到 /etc/fleet-agent 下的任何文件。
# 只在启动时读一次：之后改配置走 API 热更新，要重启时 systemd 重新打开新写的 xray.json
DynamicUser=yes
StandardInput=file:/etc/fleet-agent/xray.json
ExecStart=/usr/local/bin/xray run -c stdin:
Restart=always
RestartSec=2
LimitNOFILE=65536
# 访问日志目录：动态用户下实际在 /var/log/private/fleet-xray，/var/log/fleet-xray 是指过去的符号链接；
# 以 root 跑过的旧目录 systemd 自动搬过去并改属主（单元换回旧版时也会搬回来）。日志是 Xray 建的 0600 文件，
# agent 靠 CAP_DAC_READ_SEARCH 读，logrotate 以 root 轮转
LogsDirectory=fleet-xray
LogsDirectoryMode=0755
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# 不放 AF_UNIX：连不上 systemd / D-Bus 的本地套接字
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK
# 客户经域名（169.254.169.254.nip.io、metadata.google.internal）也到不了云厂商的元数据服务：路由里的私网拦截只认 IP 目标。
# 不拦回环（API、探测入站在 127.0.0.1）和内网段（实验室线路机、节点在 192.168.31.0/24）。
# /etc/resolv.conf 的 nameserver 是链路本地地址时（GCE、Oracle 等不经 systemd-resolved 的镜像）拦了就解析不了域名：中控装单元时去掉这一行（jobs/scripts.rs 的 LINKLOCAL_DNS）
IPAddressDeny=link-local 100.100.100.200/32
# 再把用不着的敏感目录整个藏起来（动态用户本来也读不到 0600 的令牌、主机私钥，多一层）。不存在的路径由「-」跳过
InaccessiblePaths=-/etc/fleet-agent -/var/lib/fleet-agent -/etc/ssh
# 不加 SystemCallFilter / MemoryDenyWriteExecute：Xray 是 Go 程序，升级 Xray 时运行时用到的系统调用会变，兼容风险大于收益。
# 不加 ProcSubset=pid：它藏掉 /proc/sys，Go 读不到 somaxconn，入口的监听队列从 4096 掉到 128（安全评分不变）

[Install]
WantedBy=multi-user.target
