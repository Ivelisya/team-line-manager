[Unit]
Description=fleet-agent (团队线路管理 边缘程序)
Documentation=file:///usr/local/share/doc/fleet-agent/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/fleet-agent --config /etc/fleet-agent/agent.toml run
Restart=always
RestartSec=3
# 关停时 agent 最多等约 35 s 让上报器落盘、进行中的 apply 收尾
TimeoutStopSec=45
# v1 选择：以 root 运行（线路机上要 systemctl restart fleet-xray / fleet-singbox、读写 0600 的 xray.json 与 sing-box 配置），
# 但只留 CAP_DAC_READ_SEARCH + 只读文件系统，只留下面几个可写目录。落地节点同一份单元也能用。
# /etc/fleet-singbox：线路机的 AnyTLS 外壳（sing-box）的配置与自签证书；「-」：节点上没有这个目录，跳过（装 agent 的脚本在线路机上先建好它）
# CAP_DAC_READ_SEARCH：Xray 以动态用户运行，访问日志是它建的 0600 文件（在 root 的 0700 目录 /var/log/private 下），没有它读不到
User=root
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/fleet-agent /etc/fleet-agent -/etc/fleet-singbox
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077
LimitNOFILE=4096
MemoryMax=128M
TasksMax=128
Nice=5

[Install]
WantedBy=multi-user.target
