[Unit]
Description=fleet-xray 访问日志轮转（只跑 /etc/logrotate.d/fleet-xray 这一份）
Documentation=man:logrotate(8)
# 由 fleet-xray-logrotate.timer 每小时触发：系统的 logrotate 每天只跑一次，maxsize 要靠这里才起作用。
# 与系统的 logrotate 共用状态文件（按天轮转只做一次）；logrotate 会锁状态文件，两个同时跑时后起的直接失败，
# 所以系统的那次正在跑时等它跑完
After=logrotate.service
ConditionPathExists=/etc/logrotate.d/fleet-xray

[Service]
Type=oneshot
ExecStart=/usr/sbin/logrotate /etc/logrotate.d/fleet-xray
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
NoNewPrivileges=yes
