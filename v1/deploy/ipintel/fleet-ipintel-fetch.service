# /etc/systemd/system/fleet-ipintel-fetch.service — 下载 / 更新 IP 情报离线库（由 .timer 每月触发，也可手动 systemctl start）
# 执行 `fleet-server ipintel-fetch`（取代 fetch-dbs.sh：校验和拿不到就不换，加载通过才原子换上）；库落在 /var/lib/fleet/ipintel（fleet-server 的 [ipintel] db_dir 默认值）。
# 回退到脚本：ExecStart 改回 /bin/sh /opt/fleet/ipintel/fetch-dbs.sh /var/lib/fleet/ipintel（install.sh 仍装着它），daemon-reload。
[Unit]
Description=fleet-server ipintel: refresh offline IP databases (ip2region, DB-IP lite, iptoasn)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=fleet
Group=fleet
ExecStart=/opt/fleet/fleet-server ipintel-fetch -c /etc/fleet/fleet.toml /var/lib/fleet/ipintel
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=192M
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fleet/ipintel
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
