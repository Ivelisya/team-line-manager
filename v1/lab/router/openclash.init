#!/bin/sh /etc/rc.common
# 实验室模拟的 OpenClash（lab/router/openclash.init → /etc/init.d/openclash），只做采集要看的那部分，行为同生产：
# 把源配置（uci openclash.config.config_path）复制成运行配置 /etc/openclash/<同名文件>，
# 换上 external-controller 0.0.0.0:<cn_port> 与 secret（uci dashboard_password），再起核心。
# 核心经符号链接 /etc/openclash/clash 启动：进程名是 clash（pidof clash），/proc/<pid>/exe 指向 core/clash_meta（pidof clash_meta 也找得到）。
# reload：重新生成运行配置，内容变了 procd 才重启核心；restart 总是重启。

START=99
STOP=15
USE_PROCD=1

CORE=/etc/openclash/clash

start_service() {
	local enable config_path port secret run
	config_load openclash
	config_get_bool enable config enable 0
	[ "$enable" = 1 ] || return 0
	config_get config_path config config_path
	config_get port config cn_port 9090
	config_get secret config dashboard_password
	[ -f "$config_path" ] || { echo "openclash：源配置 $config_path 不存在" >&2; return 1; }
	run="/etc/openclash/${config_path##*/}"
	(
		umask 077
		grep -v -E '^(external-controller|secret):' "$config_path" > "$run.tmp"
		printf 'external-controller: 0.0.0.0:%s\nsecret: "%s"\n' "$port" "$secret" >> "$run.tmp"
		mv "$run.tmp" "$run"
	)
	procd_open_instance
	procd_set_param command "$CORE" -d /etc/openclash -f "$run"
	procd_set_param file "$run"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger openclash
}
