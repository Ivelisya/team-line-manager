#!/bin/sh /etc/rc.common
# 实验室空壳（lab/router/router-tunnel.init → /etc/init.d/router-tunnel）：生产上同名服务把路由的 22 / 80 反向转发到 ivekasy。
# 实验室不连 ivekasy：/etc/router-tunnel/ssh_config 里的 router-relay 指向文档保留地址 192.0.2.1（连不上），服务默认不启用。
# 只用来验证接入脚本不碰它（文件与启用状态前后不变）。

START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command ssh -F /etc/router-tunnel/ssh_config -N router-relay
	procd_set_param respawn 3600 30 0
	procd_set_param stderr 1
	procd_close_instance
}
