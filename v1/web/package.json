{
  "name": "fleet-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "node tools/customer-sources.mjs --check && tsc -b tsconfig.json tsconfig.mock.json && vite build",
    "build:mock": "vite build --mode mock",
    "preview": "vite preview",
    "preview:mock": "vite preview --mode mock",
    "typecheck": "tsc -b tsconfig.json tsconfig.mock.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "e2e": "playwright test",
    "perf": "node tools/perf.mjs",
    "perf:check": "node tools/perf.mjs --check",
    "knip": "knip",
    "size": "node tools/bundle-budget.mjs",
    "check:customer": "node tools/bundle-budget.mjs --check",
    "shots": "node tools/shoot.mjs",
    "shots:ui": "node tools/shoot-ui.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-query": "5.104.1",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "date-fns": "4.4.0",
    "flag-icons": "7.2.3",
    "lucide-react": "0.577.0",
    "motion": "13.5.1",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "react-router": "7.18.5",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-array": "3.2.2",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "knip": "6.45.1",
    "oxc-parser": "0.156.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "puppeteer-core": "23.11.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
