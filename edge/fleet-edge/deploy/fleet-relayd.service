# /etc/systemd/system/fleet-relayd.service — 线路机 relayd
# 观测：本机 /proc 遥测、Xray StatsService.QueryStats(reset=false)、进程/连接统计、经 SS 的 L1/L2 探测、访问日志 tail（fleet.access.v1）。
# 管理模式（fleet.relayspec.v1）：只在 fleetd 下发期望状态 / 命令时，在 flock 下改 /etc/fleet/xray/config.json 并经 Xray API 生效
# （守卫、-test、核对、失败撤回见 src/manage.rs）；只有 restart_xray 命令会重启 fleet-xray。
#
# 为什么是 root：要读 /etc/fleet/xray/config.json（root 0600，含入站、用户与 SS 出站密码，而且由切换系统随时重写，
# 只读副本会过期，还会多一份密码拷贝；管理模式还要原子改写它）。root 是该文件的属主，读写它**不需要任何 capability**，所以这里
# CapabilityBoundingSet 为空：没有 DAC_OVERRIDE / DAC_READ_SEARCH / KILL / NET_ADMIN / SYS_PTRACE 等。
# 再加上：整个文件系统只读（ProtectSystem=strict，只有 StateDirectory、/etc/fleet/xray、/run/lock 可写）；/root、/home、sshd、shadow、
# fleetd 与 x-ui 的数据对它不可见；禁止 kill/ptrace 系列系统调用（不能给同为 root 的 xray/sshd 发信号）；
# 不能提权、不能建命名空间、不能改内核参数。
[Unit]
Description=fleet-edge relayd (observe mode: host telemetry + read-only Xray stats)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/fleet-edge/current/relayd --config /etc/fleet-edge/agent.toml
Restart=always
RestartSec=10
TimeoutStopSec=15
StateDirectory=fleet-relayd
StateDirectoryMode=0700
UMask=0077
# 资源上限（§10.3）；xray 换代时执行一次 `xray version`，子进程也算在这个 cgroup 里。
# 实测（a395，含探测 3 个节点）：RSS 6.3 MB，CPU 0.08% 单核；16 个节点的探测约再加 0.035%
# 管理操作时的 xray CLI 子进程（api / run -test，加载 geo 数据）也算在这个 cgroup 里：a395 实测含子进程峰值 28 MB
MemoryMax=128M
MemorySwapMax=0
# CPUQuota 是突发上限（CFS 每 100 ms 周期的配额），不是平均值：relayd 平均只用 ~0.1% 单核，但探测与全链路检查的
# 握手（x25519、TLS、xray 客户端启动）是几十毫秒的突发。5% 时每 100 ms 只给 5 ms，突发被切成 100 ms 一格，
# line3 实测 235 个周期里 106 个被限流、测出的延迟被放大 3–6 倍。50% 仍然防失控；与数据面争 CPU 时靠 Nice=10 让路。
CPUQuota=50%
TasksMax=64
Nice=10
IOSchedulingClass=idle
OOMScoreAdjust=500
LimitNOFILE=256
# 加固（没有任何 capability；读 Xray API 只需要 loopback TCP 或 unix socket）
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
SecureBits=noroot-locked
ProtectSystem=strict
ReadWritePaths=-/etc/fleet/xray /run/lock
ProtectHome=true
InaccessiblePaths=-/root -/etc/ssh -/etc/shadow -/etc/gshadow -/etc/sudoers -/etc/sudoers.d -/etc/fleetd -/var/lib/fleetd -/etc/x-ui -/etc/caddy -/var/lib/caddy -/etc/komari -/opt/komari -/etc/team-ops
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @debug @mount @module @reboot @swap @clock @raw-io @cpu-emulation @obsolete
SystemCallFilter=~kill tkill tgkill rt_sigqueueinfo rt_tgsigqueueinfo pidfd_send_signal process_vm_writev
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
